# =====================================================================
# LIFEDROP – PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local testing; configure on Render / Railway dashboard.
# NEVER commit the actual .env file with real credentials to GitHub.
# =====================================================================

# Server Configuration
PORT=10000
NODE_ENV=production

# ---------------------------------------------------------------------
# Option A: Discrete MySQL Parameters (Render / Railway / Cloud SQL)
# ---------------------------------------------------------------------
DB_HOST=your-mysql-host.railway.app
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=railway
DB_PORT=3306
DB_SSL=true

# ---------------------------------------------------------------------
# Option B: Complete MySQL Connection URL (Railway / PlanetScale / Aiven)
# If provided, this URL overrides the discrete DB_* variables above.
# ---------------------------------------------------------------------
# DATABASE_URL=mysql://root:password@containers-us-west-xx.railway.app:port/railway

# ---------------------------------------------------------------------
# Application Security & Administrator Credentials
# ---------------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_long_random_session_secret_key_2026
ADMIN_USERNAME=admin
# Pre-computed bcrypt hash of default password 'admin123'
ADMIN_PASSWORD_HASH=$2b$10$VM/t/0SuDxtXnM0WPS54oeHGxC/WdzRPxxLEcYya2uN3vZLsRckeC
