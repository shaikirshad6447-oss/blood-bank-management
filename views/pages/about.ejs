<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container section-pad">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">
                <i class="fa-solid fa-hospital me-1"></i> Our Mission &amp; Standards
            </span>
            <h1 class="display-6 fw-bold text-dark mb-3">About LifeDrop Blood Bank</h1>
            <p class="lead text-secondary">
                LifeDrop is designed to bridge the critical gap between voluntary blood donors and emergency clinical demands through transparent, real-time inventory management.
            </p>
            <p class="text-secondary">
                Every minute counts when trauma victims, surgery patients, or pediatric oncology patients need transfusions. By digitalizing blood group tracking, donor eligibility, and atomic stock deductions, LifeDrop eliminates administrative overhead and ensures zero discrepancy in stock allocation.
            </p>
        </div>
        <div class="col-lg-6 text-center">
            <div class="p-4 bg-white rounded-4 border shadow-sm">
                <img src="/images/hero-illustration.svg" alt="LifeDrop Safety" class="img-fluid" style="max-height: 320px;">
            </div>
        </div>
    </div>

    <!-- Core Pillars -->
    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-temperature-arrow-down"></i>
                </div>
                <h4 class="h5 fw-bold mb-2">Cold-Chain Assurance</h4>
                <p class="text-secondary small mb-0">
                    All blood components are maintained within rigorous WHO/Red Cross thermal thresholds (2°C to 6°C for whole blood and red cells) with uninterrupted digital logging.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-vial-circle-check"></i>
                </div>
                <h4 class="h5 fw-bold mb-2">Mandatory Pathogen Screening</h4>
                <p class="text-secondary small mb-0">
                    Every unit undergoes certified ELISA &amp; NAT testing for HIV, Hepatitis B &amp; C, Syphilis, and Malaria before being marked as Available in our inventory.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-hand-holding-hand"></i>
                </div>
                <h4 class="h5 fw-bold mb-2">100% Voluntary Non-Remunerated</h4>
                <p class="text-secondary small mb-0">
                    We uphold ethical voluntary donation principles. Donors donate out of empathy and altruism, ensuring the highest safety profile for recipients.
                </p>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
