<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container section-pad">
    <div class="success-card">
        <div class="success-check-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1 class="h2 fw-bold text-dark mb-2">Registration Confirmed!</h1>
        <p class="text-secondary mb-3">
            Thank you, <strong><%= donor.full_name %></strong>. You are officially enrolled in the LifeDrop voluntary blood donor network.
        </p>

        <div class="badge-code">
            DONOR ID: #DNR-<%= donor.donor_id %>
        </div>

        <div class="p-3 bg-light rounded-3 text-start my-4 border">
            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-muted d-block">Blood Group:</span>
                    <strong class="text-danger fs-6"><%= donor.blood_group %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Age / Gender:</span>
                    <strong><%= donor.age %> Years / <%= donor.gender %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Contact Phone:</span>
                    <strong><%= donor.phone %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Registered Email:</span>
                    <strong><%= donor.email %></strong>
                </div>
            </div>
        </div>

        <div class="alert alert-info border-0 bg-info-subtle text-dark small text-start mb-4">
            <i class="fa-solid fa-circle-info text-info me-2"></i>
            <strong>What happens next?</strong> When a patient with blood group <strong><%= donor.blood_group %></strong> requires urgent assistance near your area, an authorized hospital coordinator will notify you via call or SMS.
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/" class="btn btn-outline-secondary">
                <i class="fa-solid fa-house me-1"></i> Return Home
            </a>
            <a href="/availability" class="btn btn-primary-red">
                <i class="fa-solid fa-droplet me-1"></i> Check Blood Stock
            </a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
