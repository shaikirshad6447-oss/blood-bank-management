<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<!-- ======================================================================
     HERO SECTION
     ====================================================================== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-pill">
                    <span class="pulse-dot"></span>
                    <span>Verified Real-Time Blood Network</span>
                </div>
                
                <h1 class="hero-title">
                    Your One Donation <br>Can <span>Save Three Lives</span>.
                </h1>

                <p class="hero-subtitle">
                    Connect blood donors with patients in need. Join our mission to make life-saving blood accessible to everyone across hospitals and emergency trauma centers.
                </p>

                <div class="hero-actions">
                    <a href="/donate" class="btn btn-primary-red btn-lg">
                        <i class="fa-solid fa-heart me-1"></i> Become a Donor
                    </a>
                    <a href="/request" class="btn btn-outline-red btn-lg">
                        <i class="fa-solid fa-truck-medical me-1"></i> Request Blood
                    </a>
                    <a href="/availability" class="btn btn-outline-secondary btn-lg">
                        <i class="fa-solid fa-droplet text-danger me-1"></i> Check Stock
                    </a>
                </div>

                <div class="d-flex align-items-center gap-3 pt-2">
                    <div class="d-flex text-warning fs-6">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <span class="text-secondary small fw-medium">
                        Standardized cold-chain safety &amp; 100% voluntary testing
                    </span>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <div class="p-2 position-relative">
                    <img src="/images/hero-illustration.svg" alt="LifeDrop Blood Network Healthcare Visual" class="img-fluid" style="max-height: 440px;">
                </div>
            </div>
        </div>

        <!-- ==================================================================
             FOUR LIVE STATISTICS (Directly from MySQL Database)
             ================================================================== -->
        <div class="hero-stats-banner">
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.registeredDonors %></div>
                        <div class="stat-label">Registered Donors</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.availableUnits %></div>
                        <div class="stat-label">Available Blood Units</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.totalRequests %></div>
                        <div class="stat-label">Total Requests</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number"><%= stats.fulfilledRequests %></div>
                        <div class="stat-label">Fulfilled Requests</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================
     LIVE BLOOD AVAILABILITY PREVIEW
     ====================================================================== -->
<section class="section-pad bg-white border-top border-bottom">
    <div class="container">
        <div class="text-center">
            <div class="section-tag">Instant Stock Preview</div>
            <h2 class="section-heading">Live Blood Group Availability</h2>
            <p class="section-description">
                Real-time stock fetched directly from LifeDrop's verified storage inventory.
            </p>
        </div>

        <div class="row g-3">
            <% if (typeof stockPreview !== 'undefined' && stockPreview.length > 0) { %>
                <% stockPreview.forEach(function(item) { %>
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="blood-group-card">
                            <div class="blood-badge-large"><%= item.blood_group %></div>
                            <div class="stock-units-count"><%= item.units_available %></div>
                            <div class="stock-units-label">Units in Reserve</div>
                            <div>
                                <% if (item.units_available > 10) { %>
                                    <span class="stock-status-pill status-available">
                                        <i class="fa-solid fa-circle-check me-1"></i> Available
                                    </span>
                                <% } else if (item.units_available > 0) { %>
                                    <span class="stock-status-pill status-low">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Low Stock
                                    </span>
                                <% } else { %>
                                    <span class="stock-status-pill status-out">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <div class="text-center mt-4">
            <a href="/availability" class="btn btn-outline-red">
                <i class="fa-solid fa-arrow-right me-1"></i> View Full Availability &amp; Compatibility
            </a>
        </div>
    </div>
</section>

<!-- ======================================================================
     WHY DONATE BLOOD
     ====================================================================== -->
<section class="section-pad">
    <div class="container">
        <div class="text-center">
            <div class="section-tag">The Need is Constant</div>
            <h2 class="section-heading">Why Donate Blood?</h2>
            <p class="section-description">
                Every two seconds, someone needs blood for surgeries, cancer treatments, chronic illnesses, and traumatic injuries.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                    <h4 class="h5 mb-3 fw-bold">Save Multiple Lives</h4>
                    <p class="text-secondary mb-0">
                        A single donation can be separated into red blood cells, platelets, and plasma, helping up to three distinct patients in need.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <h4 class="h5 mb-3 fw-bold">Emergency Preparedness</h4>
                    <p class="text-secondary mb-0">
                        Blood cannot be manufactured synthetically; it only comes from generous donors. Maintaining ready inventory prevents catastrophic delays.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-shield-virus"></i>
                    </div>
                    <h4 class="h5 mb-3 fw-bold">Mini Health Checkup</h4>
                    <p class="text-secondary mb-0">
                        Prior to donation, you receive a free health screening including pulse, blood pressure, hemoglobin, and temperature verification.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================
     HOW IT WORKS
     ====================================================================== -->
