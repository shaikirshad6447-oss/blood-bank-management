<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container section-pad">
    <div class="success-card">
        <div class="success-check-icon">
            <i class="fa-solid fa-file-circle-check"></i>
        </div>

        <h1 class="h2 fw-bold text-dark mb-2">Blood Request Queued!</h1>
        <p class="text-secondary mb-3">
            Your blood requisition has been logged and assigned to the LifeDrop hospital operations desk.
        </p>

        <div class="badge-code">
            TRACKING ID: #REQ-<%= request.request_id %>
        </div>

        <div class="d-flex justify-content-center mb-3">
            <span class="stock-status-pill status-low">
                <i class="fa-solid fa-clock me-1"></i> Current Status: <%= request.status %>
            </span>
        </div>

        <div class="p-3 bg-light rounded-3 text-start my-4 border">
            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-muted d-block">Patient Name:</span>
                    <strong><%= request.patient_name %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Hospital / Clinic:</span>
                    <strong><%= request.hospital_name %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Required Group:</span>
                    <strong class="text-danger fs-6"><%= request.blood_group %></strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Units Requested:</span>
                    <strong><%= request.units_required %> Unit(s)</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Urgency Level:</span>
                    <span class="badge bg-danger text-white"><%= request.urgency %></span>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">Logged At:</span>
                    <strong><%= new Date(request.request_date).toLocaleString() %></strong>
                </div>
            </div>
        </div>

        <div class="alert alert-warning border-0 bg-warning-subtle text-dark small text-start mb-4">
            <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>
            <strong>Emergency Case Note:</strong> If this requisition is an immediate surgical emergency, please have the attending doctor call our 24/7 hotline at <strong>1800-LIFEDROP</strong> and quote <strong>#REQ-<%= request.request_id %></strong> for expedited approval.
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/" class="btn btn-outline-secondary">
                <i class="fa-solid fa-house me-1"></i> Return Home
            </a>
            <a href="/availability" class="btn btn-primary-red">
                <i class="fa-solid fa-droplet me-1"></i> Check Inventory
            </a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
