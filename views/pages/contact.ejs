<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container section-pad">
    <div class="text-center mb-5">
        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">
            <i class="fa-solid fa-headset me-1"></i> We Are Available 24/7
        </span>
        <h1 class="h2 fw-bold text-dark">Contact LifeDrop Emergency Desk</h1>
        <p class="text-secondary max-w-700 mx-auto" style="max-width: 600px;">
            For immediate blood requirements, blood donation camp organization, or technical inquiries, contact our round-the-clock coordination center.
        </p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Contact Information Cards -->
        <div class="col-lg-4 col-md-5">
            <div class="p-4 bg-white rounded-4 border shadow-sm mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="feature-icon-wrapper m-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                        <i class="fa-solid fa-phone-volume"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Emergency Hotline</div>
                        <div class="fw-bold text-danger fs-5">+91 1800-LIFEDROP</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="feature-icon-wrapper m-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Emergency Email</div>
                        <div class="fw-bold text-dark">dispatch@lifedrop.org</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="feature-icon-wrapper m-0" style="width: 48px; height: 48px; font-size: 1.2rem;">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Central Blood Bank</div>
                        <div class="small text-dark">Plot 12, Healthcare City, Jubilee Hills, Hyderabad</div>
                    </div>
                </div>
            </div>

            <!-- Operating Hours Box -->
            <div class="p-3 bg-light rounded-3 border small">
                <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-clock text-danger me-1"></i> Operating Hours</div>
                <div class="text-secondary">Emergency Blood Dispatch: <strong>24 Hours / 7 Days</strong></div>
                <div class="text-secondary">Donor Walk-in Centers: <strong>8:00 AM – 8:00 PM Daily</strong></div>
            </div>
        </div>

        <!-- Contact Query Form -->
        <div class="col-lg-7 col-md-7">
            <div class="form-container-card">
                <h4 class="h5 fw-bold mb-3">Send a Message or Query</h4>
                <form action="/contact" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="contactName" class="form-label-custom">Your Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-custom" id="contactName" name="name" placeholder="Aarav Sharma" required>
                        </div>
                        <div class="col-md-6">
                            <label for="contactEmail" class="form-label-custom">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control form-control-custom" id="contactEmail" name="email" placeholder="name@example.com" required>
                        </div>
                        <div class="col-md-12">
                            <label for="contactSubject" class="form-label-custom">Subject <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-custom" id="contactSubject" name="subject" placeholder="e.g. Inquiring about organizing a college donation drive" required>
                        </div>
                        <div class="col-md-12">
                            <label for="contactMessage" class="form-label-custom">Message <span class="text-danger">*</span></label>
                            <textarea class="form-control form-control-custom" id="contactMessage" name="message" rows="4" placeholder="How can our clinical coordinator team assist you?" required></textarea>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary-red px-4">
                                <i class="fa-solid fa-paper-plane me-1"></i> Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
