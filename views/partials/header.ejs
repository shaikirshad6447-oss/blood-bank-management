<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title><%= typeof title !== 'undefined' ? title : 'LifeDrop | Blood Bank Management System' %></title>
    
    <!-- Meta tags for Healthcare Portal -->
    <meta name="description" content="LifeDrop Blood Bank Management System connects eligible donors with emergency patients in need. Real-time blood availability and verified stock.">
    
    <!-- Google Fonts: Inter & Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom Theme Stylesheets -->
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <link rel="stylesheet" href="/css/admin.css">
    <% } %>
</head>
<body class="<%= typeof isAdmin !== 'undefined' && isAdmin ? 'admin-body' : '' %>">
