<%- include('../partials/header', { isAdmin: true, title: 'Edit Donor Profile | LifeDrop Admin' }) %>

<div class="d-flex">
    <%- include('../partials/adminSidebar', { activePage: 'donors' }) %>

    <div class="admin-main-wrapper flex-grow-1">
        <%- include('../partials/adminNavbar', { pageTitle: 'Edit Donor Profile' }) %>
        <%- include('../partials/alerts') %>

        <div class="admin-content-body">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="admin-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <h3 class="h5 fw-bold text-dark m-0">Editing Donor: <%= donor.full_name %></h3>
                                <div class="text-muted small">Record ID: #<%= donor.donor_id %></div>
                            </div>
                            <a href="/admin/donors" class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to Donors
                            </a>
                        </div>

                        <form action="/admin/donors/<%= donor.donor_id %>/edit" method="POST" novalidate>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label-custom">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-custom" name="full_name" value="<%= donor.full_name %>" required minlength="3">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Age (Years) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control form-control-custom" name="age" min="18" max="65" value="<%= donor.age %>" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Gender <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-custom" name="gender" required>
                                        <option value="Male" <%= donor.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                        <option value="Female" <%= donor.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                        <option value="Other" <%= donor.gender === 'Other' ? 'selected' : '' %>>Other</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Blood Group <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-custom fw-semibold" name="blood_group" required>
                                        <% bloodGroups.forEach(function(bg) { %>
                                            <option value="<%= bg %>" <%= donor.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Phone Number <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control form-control-custom" name="phone" value="<%= donor.phone %>" required pattern="[0-9+\-\s()]{10,20}">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control form-control-custom" name="email" value="<%= donor.email %>" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Last Donation Date</label>
                                    <input type="date" class="form-control form-control-custom" name="last_donation_date" value="<%= donor.last_donation_date ? new Date(donor.last_donation_date).toISOString().split('T')[0] : '' %>">
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label-custom">Residential Address <span class="text-danger">*</span></label>
                                    <textarea class="form-control form-control-custom" name="address" rows="3" required><%= donor.address %></textarea>
                                </div>

                                <div class="col-12 text-end mt-4">
                                    <a href="/admin/donors" class="btn btn-secondary me-2">Cancel</a>
                                    <button type="submit" class="btn btn-primary-red">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
