<%- include('../partials/header', { isAdmin: true, title: 'Manage Blood Stock Inventory | LifeDrop Admin' }) %>

<div class="d-flex">
    <%- include('../partials/adminSidebar', { activePage: 'stock' }) %>

    <div class="admin-main-wrapper flex-grow-1">
        <%- include('../partials/adminNavbar', { pageTitle: 'Blood Stock Inventory Control' }) %>
        <%- include('../partials/alerts') %>

        <div class="admin-content-body">
            <!-- Summary Banner -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Blood Units</div>
                            <div class="kpi-value text-danger"><%= totalUnits %></div>
                        </div>
                        <div class="kpi-icon-box kpi-icon-red">
                            <i class="fa-solid fa-droplet"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Tracked Groups</div>
                            <div class="kpi-value text-primary">8 Groups</div>
                        </div>
                        <div class="kpi-icon-box kpi-icon-blue">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Low Stock Groups</div>
                            <div class="kpi-value text-warning"><%= lowStockCount %></div>
                        </div>
                        <div class="kpi-icon-box kpi-icon-amber">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transaction Safety Notice -->
            <div class="alert alert-info border-info-subtle shadow-sm small d-flex align-items-center gap-2 mb-4">
                <i class="fa-solid fa-database text-info fs-5"></i>
                <div>
                    <strong>ACID Transaction Protected:</strong> All stock adjustments use InnoDB transactions (<code>START TRANSACTION</code>, row-level locks, and <code>COMMIT</code>) and strictly prevent negative inventory.
                </div>
            </div>

            <!-- 8 Blood Group Inventory Cards & Adjustment -->
            <div class="row g-4 mb-4">
                <% if (stockList && stockList.length > 0) { %>
                    <% stockList.forEach(function(stock) { %>
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <div class="admin-card h-100 p-4 text-center d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge bg-danger text-white fs-6 fw-bold px-3 py-1"><%= stock.blood_group %></span>
                                        <% if (stock.units_available > 10) { %>
                                            <span class="stock-status-pill status-available">Available</span>
                                        <% } else if (stock.units_available > 0) { %>
                                            <span class="stock-status-pill status-low">Low Stock</span>
                                        <% } else { %>
                                            <span class="stock-status-pill status-out">Out of Stock</span>
                                        <% } %>
                                    </div>

                                    <div class="display-6 fw-bold text-dark my-2" style="font-family: 'Manrope', sans-serif;">
                                        <%= stock.units_available %>
                                    </div>
                                    <div class="small text-secondary mb-3">Units in Reserve</div>

                                    <!-- Visual Level Bar -->
                                    <div class="progress mb-3" style="height: 8px;">
                                        <% const percent = Math.min(100, Math.round((stock.units_available / 50) * 100)); %>
                                        <div class="progress-bar <%= stock.units_available > 10 ? 'bg-success' : (stock.units_available > 0 ? 'bg-warning' : 'bg-danger') %>" 
                                             role="progressbar" 
                                             style="width: <%= percent %>%;" 
                                             aria-valuenow="<%= stock.units_available %>" 
                                             aria-valuemin="0" 
                                             aria-valuemax="50">
                                        </div>
                                    </div>

                                    <div class="small text-muted mb-3" style="font-size: 0.75rem;">
                                        Last Updated: <%= new Date(stock.last_updated).toLocaleString() %>
                                    </div>
                                </div>

                                <div>
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#stockAdjustModal"
                                            data-blood-group="<%= stock.blood_group %>"
                                            data-current-units="<%= stock.units_available %>">
                                        <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================================
     ADJUST STOCK MODAL (ACID TRANSACTION SAFE)
     ====================================================================== -->
<div class="modal fade" id="stockAdjustModal" tabindex="-1" aria-labelledby="stockAdjustModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="stockAdjustModalLabel">
                    <i class="fa-solid fa-boxes-stacked me-2"></i> Inventory Adjustment: <span id="modalBloodGroupDisplay" class="fw-bold"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/stock/adjust" method="POST">
                <input type="hidden" name="blood_group" id="modalBloodGroup">
                
                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-secondary small">Currently Available Reserve:</span>
                        <strong class="fs-5 text-dark"><span id="modalCurrentUnitsDisplay">0</span> Units</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Operation Type <span class="text-danger">*</span></label>
                        <select class="form-select form-select-custom" name="operation" required>
                            <option value="add">Add Units to Inventory (+)</option>
                            <option value="set">Set Exact Count (=)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Units Amount <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-custom" name="amount" min="1" max="500" placeholder="e.g. 5" required>
                        <div class="small text-muted mt-1">Enforced by MySQL check constraints to prevent negative inventory.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa-solid fa-check me-1"></i> Confirm Inventory Update
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
