<%- include('../partials/header', { isAdmin: true, title: 'Manage Registered Donors | LifeDrop Admin' }) %>

<div class="d-flex">
    <%- include('../partials/adminSidebar', { activePage: 'donors' }) %>

    <div class="admin-main-wrapper flex-grow-1">
        <%- include('../partials/adminNavbar', { pageTitle: 'Donor Directory & Management' }) %>
        <%- include('../partials/alerts') %>

        <div class="admin-content-body">
            <!-- Filter Bar -->
            <div class="admin-card p-3 mb-4">
                <form action="/admin/donors" method="GET" class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" class="form-control border-start-0" name="search" placeholder="Search by donor name, phone, email, address..." value="<%= search %>">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" name="bloodGroup">
                            <option value="">All Blood Groups</option>
                            <% bloodGroups.forEach(function(bg) { %>
                                <option value="<%= bg %>" <%= bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary-red flex-grow-1">
                            <i class="fa-solid fa-filter me-1"></i> Filter
                        </button>
                        <% if (search || bloodGroup) { %>
                            <a href="/admin/donors" class="btn btn-outline-secondary" title="Clear Filters">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Donor Table Card -->
            <div class="admin-card">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <h3 class="admin-card-title">
                        <i class="fa-solid fa-users text-danger me-2"></i> Registered Donors (<%= totalCount %>)
                    </h3>
                    <a href="/donate" target="_blank" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-plus me-1"></i> New Donor
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Full Name</th>
                                <th>Group</th>
                                <th>Age / Gender</th>
                                <th>Contact Details</th>
                                <th>Last Donation</th>
                                <th>Registered</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (donors && donors.length > 0) { %>
                                <% donors.forEach(function(donor) { %>
                                    <tr>
                                        <td><span class="text-muted fw-semibold">#<%= donor.donor_id %></span></td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= donor.full_name %></div>
                                            <div class="small text-muted text-truncate" style="max-width: 180px;"><%= donor.address %></div>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger fs-6 fw-bold"><%= donor.blood_group %></span>
                                        </td>
                                        <td><%= donor.age %> Yrs &bull; <%= donor.gender %></td>
                                        <td>
                                            <div><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= donor.phone %></div>
                                            <div class="small text-muted"><i class="fa-solid fa-envelope me-1 small"></i> <%= donor.email %></div>
                                        </td>
                                        <td>
                                            <%= donor.last_donation_date ? new Date(donor.last_donation_date).toLocaleDateString() : '<span class="text-muted small">None logged</span>' %>
                                        </td>
                                        <td class="small text-muted">
                                            <%= new Date(donor.created_at).toLocaleDateString() %>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/admin/donors/<%= donor.donor_id %>/edit" class="btn btn-outline-primary" title="Edit Donor">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#deleteDonorModal"
                                                        data-donor-id="<%= donor.donor_id %>"
                                                        data-donor-name="<%= donor.full_name %>"
                                                        title="Delete Donor">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-user-slash fs-2 mb-2 d-block"></i>
                                        No donor records found matching the specified criteria.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalCount %> total donors)
                        </div>
                        <nav aria-label="Donor pagination">
                            <ul class="pagination pagination-sm m-0">
                                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/donors?page=<%= currentPage - 1 %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>">Previous</a>
                                </li>
                                <% for (let p = 1; p <= totalPages; p++) { %>
                                    <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                        <a class="page-link" href="/admin/donors?page=<%= p %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>"><%= p %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/donors?page=<%= currentPage + 1 %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================================
     DELETE DONOR CONFIRMATION MODAL
     ====================================================================== -->
<div class="modal fade" id="deleteDonorModal" tabindex="-1" aria-labelledby="deleteDonorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteDonorModalLabel"><i class="fa-solid fa-triangle-exclamation me-2"></i> Confirm Record Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p>Are you certain you wish to delete the donor profile for <strong id="deleteDonorNameDisplay" class="text-danger"></strong>?</p>
                <p class="text-secondary small mb-0">This operation permanently removes the donor from the MySQL database and cannot be undone.</p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteDonorForm" method="POST" action="">
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa-solid fa-trash me-1"></i> Yes, Delete Record
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Bundle & Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
