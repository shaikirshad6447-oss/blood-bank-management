<%- include('../partials/header', { isAdmin: true, title: 'Manage Blood Requisitions | LifeDrop Admin' }) %>

<div class="d-flex">
    <%- include('../partials/adminSidebar', { activePage: 'requests' }) %>

    <div class="admin-main-wrapper flex-grow-1">
        <%- include('../partials/adminNavbar', { pageTitle: 'Blood Requisitions & Allocation' }) %>
        <%- include('../partials/alerts') %>

        <div class="admin-content-body">
            <!-- Filter Bar -->
            <div class="admin-card p-3 mb-4">
                <form action="/admin/requests" method="GET" class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" class="form-control border-start-0" name="search" placeholder="Patient, hospital, phone..." value="<%= search %>">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="bloodGroup">
                            <option value="">All Blood Groups</option>
                            <% bloodGroups.forEach(function(bg) { %>
                                <option value="<%= bg %>" <%= bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="urgency">
                            <option value="">All Urgencies</option>
                            <% urgencyLevels.forEach(function(u) { %>
                                <option value="<%= u %>" <%= urgency === u ? 'selected' : '' %>><%= u %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="status">
                            <option value="">All Statuses</option>
                            <option value="Pending" <%= status === 'Pending' ? 'selected' : '' %>>Pending</option>
                            <option value="Approved" <%= status === 'Approved' ? 'selected' : '' %>>Approved</option>
                            <option value="Fulfilled" <%= status === 'Fulfilled' ? 'selected' : '' %>>Fulfilled</option>
                            <option value="Rejected" <%= status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary-red flex-grow-1">
                            <i class="fa-solid fa-filter me-1"></i> Filter
                        </button>
                        <% if (search || bloodGroup || urgency || status) { %>
                            <a href="/admin/requests" class="btn btn-outline-secondary" title="Clear Filters">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Requests Table Card -->
            <div class="admin-card">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <h3 class="admin-card-title">
                        <i class="fa-solid fa-clipboard-list text-danger me-2"></i> Patient Blood Requisitions (<%= totalCount %>)
                    </h3>
                    <a href="/request" target="_blank" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-plus me-1"></i> New Request
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Patient &amp; Hospital</th>
                                <th>Group Required</th>
                                <th>Units (Req / Available)</th>
                                <th>Urgency</th>
                                <th>Contact Number</th>
                                <th>Status</th>
                                <th>Request Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (requests && requests.length > 0) { %>
                                <% requests.forEach(function(reqItem) { %>
                                    <% const inStock = stockMap[reqItem.blood_group] !== undefined ? stockMap[reqItem.blood_group] : 0; %>
                                    <% const hasSufficientStock = inStock >= reqItem.units_required; %>
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border fw-bold">#<%= reqItem.request_id %></span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= reqItem.patient_name %></div>
                                            <div class="small text-muted text-truncate" style="max-width: 180px;"><%= reqItem.hospital_name %></div>
                                            <% if (reqItem.additional_notes) { %>
                                                <div class="small text-secondary fst-italic text-truncate" style="max-width: 180px;" title="<%= reqItem.additional_notes %>">
                                                    Note: <%= reqItem.additional_notes %>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger fs-6 fw-bold"><%= reqItem.blood_group %></span>
                                        </td>
                                        <td>
                                            <strong><%= reqItem.units_required %> Unit(s)</strong>
                                            <div class="small <%= hasSufficientStock ? 'text-success' : 'text-danger fw-bold' %>">
                                                Stock: <%= inStock %> Avail.
                                            </div>
                                        </td>
                                        <td>
                                            <% if (reqItem.urgency === 'Emergency') { %>
                                                <span class="badge-status badge-urgency-emergency">Emergency</span>
                                            <% } else if (reqItem.urgency === 'Urgent') { %>
                                                <span class="badge-status badge-urgency-urgent">Urgent</span>
                                            <% } else { %>
                                                <span class="badge-status badge-urgency-normal">Normal</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= reqItem.contact_number %></div>
                                        </td>
                                        <td>
                                            <% if (reqItem.status === 'Pending') { %>
                                                <span class="badge-status badge-pending">Pending</span>
                                            <% } else if (reqItem.status === 'Approved') { %>
                                                <span class="badge-status badge-approved">Approved</span>
                                            <% } else if (reqItem.status === 'Fulfilled') { %>
                                                <span class="badge-status badge-fulfilled">Fulfilled</span>
                                            <% } else { %>
                                                <span class="badge-status badge-rejected">Rejected</span>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted">
                                            <%= new Date(reqItem.request_date).toLocaleDateString() %><br>
                                            <span style="font-size: 0.72rem;"><%= new Date(reqItem.request_date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                                        </td>
                                        <td class="text-end">
                                            <% if (reqItem.status === 'Pending') { %>
                                                <div class="d-flex justify-content-end gap-1">
                                                    <!-- Approve Button (Triggers atomic stock deduction) -->
                                                    <form method="POST" action="/admin/requests/<%= reqItem.request_id %>/approve" onsubmit="return confirm('Approve request #<%= reqItem.request_id %> and deduct <%= reqItem.units_required %> unit(s) of <%= reqItem.blood_group %> from stock?');">
                                                        <button type="submit" class="btn btn-sm <%= hasSufficientStock ? 'btn-success' : 'btn-outline-danger' %>" title="<%= hasSufficientStock ? 'Approve and deduct stock' : 'Insufficient stock in inventory!' %>">
                                                            <i class="fa-solid fa-check me-1"></i> Approve
                                                        </button>
                                                    </form>

                                                    <!-- Reject Button -->
                                                    <form method="POST" action="/admin/requests/<%= reqItem.request_id %>/reject" onsubmit="return confirm('Reject request #<%= reqItem.request_id %>? Stock will NOT be deducted.');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject Request">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } else if (reqItem.status === 'Approved') { %>
                                                <form method="POST" action="/admin/requests/<%= reqItem.request_id %>/fulfill" onsubmit="return confirm('Mark request #<%= reqItem.request_id %> as Fulfilled (dispatched to hospital)?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="fa-solid fa-truck me-1"></i> Fulfill
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted small">No actions</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-clipboard-check fs-2 mb-2 d-block"></i>
                                        No blood requests found matching your filter criteria.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalCount %> requests)
                        </div>
                        <nav aria-label="Requests pagination">
                            <ul class="pagination pagination-sm m-0">
                                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/requests?page=<%= currentPage - 1 %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>&urgency=<%= urgency %>&status=<%= status %>">Previous</a>
                                </li>
                                <% for (let p = 1; p <= totalPages; p++) { %>
                                    <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                        <a class="page-link" href="/admin/requests?page=<%= p %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>&urgency=<%= urgency %>&status=<%= status %>"><%= p %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/requests?page=<%= currentPage + 1 %>&search=<%= search %>&bloodGroup=<%= bloodGroup %>&urgency=<%= urgency %>&status=<%= status %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
